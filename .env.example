TEVEL_FORM_URL=https://forms.monday.com/forms/10a9b1154e8e65b9db479776224827a5?r=euc1
WORKER_LIVE_VIEW_PORT=7900

# --- Storage ---
UPLOAD_DIR=./data/uploads
