[Unit]
Description=PTW Worker (Playwright submitter + schema snapshot)
After=network.target postgresql.service redis-server.service xvfb.service
Requires=xvfb.service

[Service]
Type=simple
User=ptw
WorkingDirectory=/var/www/ptw/app/apps/api
EnvironmentFile=/var/www/ptw/app/.env
Environment=DISPLAY=:99
ExecStart=/usr/bin/node dist/workers/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
