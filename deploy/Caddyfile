ptw.crtgeeb.co.il {
    encode zstd gzip

    # noVNC for the worker browser (CAPTCHA solving). DISABLED by default
    # because Caddy refuses to load with an invalid basic_auth hash.
    #
    # To enable:
    #   1. caddy hash-password   # type your password, copy the bcrypt hash
    #   2. Uncomment the block below and paste the hash where indicated.
    #   3. systemctl reload caddy
    #
    # handle_path /vnc/* {
    #     basic_auth {
    #         ptwadmin $2a$14$REPLACE_THIS_WITH_REAL_BCRYPT_HASH
    #     }
    #     reverse_proxy 127.0.0.1:7900
    # }

    # API
    handle_path /api/* {
        reverse_proxy 127.0.0.1:4000
    }

    # SPA — same static bundle for all other paths, including /share/<token>.
    handle {
        root * /var/www/ptw/web
        try_files {path} /index.html
        file_server
    }

    log {
        output file /var/log/caddy/ptw.access.log
        format json
    }
}
