ptw.crtgeeb.co.il {
    encode zstd gzip

    # Live view of the worker's Chromium (noVNC). Only logged-in users get
    # through — Caddy does a forward-auth round-trip to the API which checks
    # the session cookie before allowing the proxy.
    handle_path /vnc/* {
        forward_auth 127.0.0.1:4000 {
            uri /auth/check
            copy_headers Cookie
        }
        reverse_proxy 127.0.0.1:7900
    }

    # API
    handle_path /api/* {
        reverse_proxy 127.0.0.1:4000
    }

    # SPA — same static bundle for all other paths, including /share/<token>.
    handle {
        root * /var/www/ptw/web
        try_files {path} /index.html
        file_server
    }

    log {
        output file /var/log/caddy/ptw.access.log
        format json
    }
}
