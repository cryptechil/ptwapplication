[Unit]
Description=PTW API
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=ptw
WorkingDirectory=/var/www/ptw/app/apps/api
EnvironmentFile=/var/www/ptw/app/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
